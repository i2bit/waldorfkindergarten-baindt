---
// Impressum: Anbieterangaben aus den Daten „Verein“ und „Kontakt“,
// der Haftungsausschluss als Abschnitte der Seite „Impressum“ im Admin.
import Inhaltsseite from '../components/Inhaltsseite.astro';
import Rechtstext from '../components/Rechtstext.astro';
import { reader, getKontakt } from '../lib/content';

const seite = await reader.singletons.impressum.readOrThrow();
const verein = await reader.singletons.verein.readOrThrow();
const k = await getKontakt();
---
<Inhaltsseite seite={seite} sprungmarken={false}>
  <Fragment slot="vorher">
  <Rechtstext>
      <div class="block">
        <h2 class="h3">Anbieter</h2>
        <dl><div class="zeile"><dt>Träger</dt><dd>{verein.name}<br />{k.strasse}<br />{k.ort}</dd></div></dl>
      </div>
      <div class="block">
        <h2 class="h3">Vertreten durch den Vorstand</h2>
        <dl>{verein.vorstand.map((v) => <div class="zeile"><dt>Bereich {v.bereich}</dt><dd>{v.namen}</dd></div>)}</dl>
      </div>
      <div class="block">
        <h2 class="h3">Kontakt</h2>
        <dl>
          <div class="zeile"><dt>Telefon</dt><dd><a href={k.telHref}>{k.telefon}</a></dd></div>
          <div class="zeile"><dt>E-Mail</dt><dd><a href={k.mailHref}>{k.email}</a></dd></div>
        </dl>
      </div>
      <div class="block">
        <h2 class="h3">Registereintrag</h2>
        <dl>
          <div class="zeile"><dt>Eintragung</dt><dd>Vereinsregister</dd></div>
          <div class="zeile"><dt>Registergericht</dt><dd>{verein.registergericht}</dd></div>
          <div class="zeile"><dt>Registernummer</dt><dd>{verein.registernummer}</dd></div>
        </dl>
      </div>
      <div class="block">
        <h2 class="h3">Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
        <dl><div class="zeile"><dt>Name</dt><dd>{verein.verantwortlich}<br />{k.strasse}, {k.ort}</dd></div></dl>
      </div>
  
    </Rechtstext>
  </Fragment>
</Inhaltsseite>
