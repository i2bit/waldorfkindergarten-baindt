---
// Startseite, bewusst schlicht (Vorbild: waldorfkindergarten-wurzelwerk.de):
// Logo und Spruch, Willkommenstext mit Foto, eine Reihe Fotos, die beiden Gruppen,
// die letzten Berichte und ein Hinweis zum Kennenlernen. Alles in Keystatic pflegbar.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { reader, getAktuelles, bild, renderMarkdoc, nurText, ankerVon, datumLang } from '../lib/content';
import logo from '../assets/logo.png';

const start = await reader.singletons.startseite.readOrThrow();
const gruppenSeite = await reader.singletons.gruppen.readOrThrow();
const gruppen = gruppenSeite.abschnitte.filter((a) => a.aufStartseite);
const posts = (await getAktuelles()).slice(0, 3);

const willkommen = renderMarkdoc(start.willkommen.node);
const beschreibung = nurText(start.willkommen.node).slice(0, 160);
const zitatZeilen = start.zitat.split('\n').map((z) => z.trim()).filter(Boolean);
const bilder = start.bilder.filter((b) => b.bild);
---
<Base title="Startseite" description={beschreibung}>
  <div slot="kopf" class="wrap hero">
    <h1 class="visually-hidden">Waldorfkindergarten Baindt</h1>
    <Image src={logo} alt="" class="hero-logo" width={86} height={150} densities={[1, 2]} loading="eager" />
    {zitatZeilen.length > 0 && (
      <figure class="zitat">
        <blockquote>
          <p>„{zitatZeilen.map((z, i) => <>{i > 0 && <br />}{z}</>)}“</p>
        </blockquote>
        {start.zitatQuelle && <figcaption>{start.zitatQuelle}</figcaption>}
      </figure>
    )}
  </div>

  <section class="wrap section" aria-labelledby="willkommen">
    <div class="split">
      <div class="stack">
        <h2 class="h2" id="willkommen">{start.willkommenTitel || 'Willkommen'}</h2>
        <div class="prosa" set:html={willkommen} />
        <a href="/ueber-uns" class="linkpfeil">Mehr über uns →</a>
      </div>
      {start.heroBild && (
        <Image src={bild(start.heroBild)} alt={start.heroBildAlt ?? ''} class="foto" style="--h:460px" widths={[600, 1200]} sizes="(min-width: 1000px) 600px, 92vw" loading="eager" />
      )}
    </div>
  </section>

  {bilder.length > 0 && (
    <section class="wrap bilderreihe" aria-label="Eindrücke">
      {bilder.map((b) => (
        <Image src={bild(b.bild)} alt={b.alt ?? ''} widths={[400, 800]} sizes="(min-width: 1000px) 400px, 92vw" />
      ))}
    </section>
  )}

  {gruppen.length > 0 && (
    <section class="bg-pfirsich welle-oben welle-unten" aria-labelledby="gruppen-titel">
      <div class="wrap section">
        <h2 class="h2" id="gruppen-titel">Unsere Gruppen</h2>
        <div class="grid" style="--min:300px;gap:28px">
          {gruppen.map((g) => (
            <div class="gruppe stack">
              <h3 class="h3">{g.titel}</h3>
              {g.kurz && <p class="p">{g.kurz}</p>}
              <a href={`/gruppen#${ankerVon(g)}`} class="linkpfeil">Mehr über {g.titel} →</a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="wrap section" aria-labelledby="aktuelles-titel">
    <h2 class="h2" id="aktuelles-titel">Aktuelles</h2>
    <ul class="neues">
      {posts.map((p) => (
        <li>
          <span class="p-leise">{datumLang(p.entry.datum)}</span>
          <a href={`/aktuelles/${p.slug}`}>{p.entry.titel}</a>
        </li>
      ))}
    </ul>
    <a href="/aktuelles" class="linkpfeil">Alle Berichte →</a>
  </section>

  <section class="bg-hell-honig" aria-labelledby="platz-titel">
    <div class="wrap section platz">
      <h2 class="h2" id="platz-titel">{start.platzTitel}</h2>
      <p class="p">{start.platzText}</p>
      <div class="knoepfe">
        <a href="/kontakt" class="btn">Besuch vereinbaren</a>
        <a href="/anmeldung" class="btn btn-rahmen">Zum Aufnahmeantrag</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: 40px; padding-bottom: 72px; display: flex; flex-direction: column; align-items: center; gap: 32px; text-align: center; }
  .hero-logo { height: 150px; width: auto; }
  .zitat { margin: 0; max-width: 1060px; }
  .zitat blockquote { margin: 0; }
  .zitat p {
    margin: 0;
    font-family: var(--font-titel);
    font-size: clamp(19px, 2.5vw, 32px);
    line-height: 1.35;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    text-wrap: balance;
  }
  .zitat figcaption { margin-top: 16px; font-size: 18px; color: var(--text-leise); }

  .bilderreihe { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 20px; padding-bottom: 96px; }
  .bilderreihe img { width: 100%; aspect-ratio: 4 / 5; height: auto; object-fit: cover; border-radius: 24px; }

  .gruppe { background: var(--grund); border-radius: 24px; padding: 30px; }
  .gruppe .h3 { font-size: 32px; color: var(--akzent); text-transform: uppercase; letter-spacing: 0.03em; }

  .neues { margin: 0; padding: 0; list-style: none; max-width: 760px; }
  .neues li { display: flex; flex-direction: column; gap: 2px; padding: 16px 0; border-bottom: 1px solid var(--linie); }
  .neues a { font-family: var(--font-titel); font-size: 24px; text-decoration: none; }
  .neues a:hover { text-decoration: underline; }

  .bg-hell-honig { background: var(--hell-honig); }
  .platz { align-items: center; text-align: center; }
  .platz .p { max-width: 640px; }
  .knoepfe { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .knoepfe .btn { align-self: auto; }
</style>
