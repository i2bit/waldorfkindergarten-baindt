---
// Startseite: ruhig aufgebaut wie bei anderen Waldorfkindergärten –
// Logo und Spruch oben, darunter Text und Foto im Wechsel.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Jahreskreis from '../components/Jahreskreis.astro';
import Zettel from '../components/Zettel.astro';
import { reader, getAktuelles, bild } from '../lib/content';
import logo from '../assets/logo.png';

const start = await reader.singletons.startseite.readOrThrow();
const gruppen = await reader.singletons.gruppen.readOrThrow();
const posts = (await getAktuelles()).slice(0, 3);

const einleitungsBild = bild(start.heroBild, 'haus.jpg');
const einleitungsAlt = start.heroBild ? 'Foto aus dem Kindergarten' : 'Das Kindergartengebäude mit blühendem Garten';
const zitatZeilen = start.zitat.split('\n').map((z) => z.trim()).filter(Boolean);

const gruppenFotos = [
  { datei: 'sand.jpg', alt: 'Zwei Kinder spielen im Sandkasten' },
  { datei: 'bauen.jpg', alt: 'Drei Kinder bauen einen hohen Turm aus Holzplättchen' },
];
const anker = (name: string) => name.toLowerCase().replace(/ß/g, 'ss').replace(/[^a-z]/g, '');
---
<Base title="Startseite" description={start.heroText}>
  <div slot="kopf" class="wrap hero">
    <h1 class="visually-hidden">Waldorfkindergarten Baindt</h1>
    <Image src={logo} alt="" class="hero-logo" width={86} height={150} densities={[1, 2]} loading="eager" />
    {zitatZeilen.length > 0 && (
      <figure class="zitat">
        <blockquote>
          <p>„{zitatZeilen.map((z, i) => <>{i > 0 && <br />}{z}</>)}“</p>
        </blockquote>
        {start.zitatQuelle && <figcaption>{start.zitatQuelle}</figcaption>}
      </figure>
    )}
  </div>

  <section class="wrap section" aria-labelledby="willkommen">
    <div class="split">
      <div class="stack">
        <h2 class="h2" id="willkommen">Willkommen</h2>
        <p class="p">{start.heroText}</p>
        <p class="p">Bei uns steht das Kind im Mittelpunkt: mit Rhythmus im Tag, viel Zeit für freies Spiel, Natur vor der Tür und einer lebendigen Gemeinschaft von Eltern und Team.</p>
        <a href="/ueber-uns" class="linkpfeil">Mehr über uns und unsere Pädagogik →</a>
      </div>
      <Image src={einleitungsBild} alt={einleitungsAlt} class="foto" widths={[600, 1200]} sizes="(min-width: 1000px) 600px, 92vw" loading="eager" />
    </div>
  </section>

  <section class="bg-pfirsich welle-oben welle-unten" aria-labelledby="gruppen-titel">
    <div class="wrap section">
      <h2 class="h2" id="gruppen-titel">Unsere Gruppen</h2>
      {gruppen.gruppen.map((g, i) => {
        const foto = gruppenFotos[i % gruppenFotos.length];
        return (
          <div class="split gruppe" class:list={{ 'bild-rechts': i % 2 === 1 }}>
            <Image src={bild(g.bild, foto.datei)} alt={g.bild ? `Foto der Gruppe ${g.name}` : foto.alt} class="foto" style="--h:340px" widths={[600, 1200]} sizes="(min-width: 1000px) 600px, 92vw" />
            <div class="stack">
              <h3 class="h3">{g.name}</h3>
              {g.alter && <p class="p-leise gruppe-alter">{g.alter}</p>}
              <p class="p">{g.text}</p>
              <a href={`/gruppen#${anker(g.name)}`} class="linkpfeil">Mehr über {g.name} →</a>
            </div>
          </div>
        );
      })}
      <p class="p">Außerdem: <a href="/gruppen#ganztag">Ganztag im Zwergenstübchen</a> · <a href="/gruppen#vorschule">Vorschuljahr</a> · <a href="/fuer-eltern#zeiten">Öffnungszeiten und Beiträge</a></p>
    </div>
  </section>

  <section class="wrap section" id="jahreskreis">
    <Jahreskreis>
      <a href="/fuer-eltern#downloads" class="linkpfeil">Zum Jahresplan mit allen Terminen →</a>
    </Jahreskreis>
  </section>

  <section class="bg-hell-honig" aria-labelledby="aktuelles-titel">
    <div class="wrap section">
      <h2 class="h2" id="aktuelles-titel">Aktuelles</h2>
      <div class="pinnwand" style="gap:32px">
        {posts.map((p, i) => (
          <Zettel slug={p.slug} titel={p.entry.titel} datum={p.entry.datum} jahreszeit={p.entry.jahreszeit} teaser={p.entry.teaser} index={i} />
        ))}
      </div>
      <a href="/aktuelles" class="linkpfeil">Alle Berichte →</a>
    </div>
  </section>

  <section class="wrap section platz" aria-labelledby="platz-titel">
    <h2 class="h2" id="platz-titel">Interesse an einem Platz?</h2>
    <p class="p">Wir zeigen Ihnen gern den Kindergarten. Rufen Sie uns an oder schicken Sie uns direkt den Aufnahmeantrag.</p>
    <div class="knoepfe">
      <a href="/anmeldung" class="btn">Zum Aufnahmeantrag</a>
      <a href="/kontakt" class="btn btn-rahmen">Besuch vereinbaren</a>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: 40px; padding-bottom: 72px; display: flex; flex-direction: column; align-items: center; gap: 32px; text-align: center; }
  .hero-logo { height: 150px; width: auto; }
  .zitat { margin: 0; max-width: 1060px; }
  .zitat blockquote { margin: 0; }
  .zitat p {
    margin: 0;
    font-family: var(--font-titel);
    font-size: clamp(19px, 2.5vw, 32px);
    line-height: 1.35;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    text-wrap: balance;
  }
  .zitat figcaption { margin-top: 16px; font-size: 18px; color: var(--text-leise); }

  .gruppe { padding-top: 8px; }
  .gruppe .h3 { font-size: 34px; color: var(--akzent); text-transform: uppercase; letter-spacing: 0.03em; }
  .gruppe-alter { font-size: 17px; font-weight: 600; margin-top: -8px; }
  @media (min-width: 900px) {
    .bild-rechts > :first-child { order: 2; }
  }

  .bg-hell-honig { background: var(--hell-honig); }

  .platz { align-items: center; text-align: center; }
  .platz .p { max-width: 640px; }
  .knoepfe { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .knoepfe .btn { align-self: auto; }
</style>
