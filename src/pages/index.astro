---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Jahreskreis from '../components/Jahreskreis.astro';
import Zettel from '../components/Zettel.astro';
import { reader, getAktuelles, bild, hervorheben } from '../lib/content';

const start = await reader.singletons.startseite.readOrThrow();
const gruppen = await reader.singletons.gruppen.readOrThrow();
const posts = (await getAktuelles()).slice(0, 3);
const stellen = (await reader.collections.stellen.all()).filter((s) => s.entry.aktiv);

const heroBild = bild(start.heroBild, 'feuer.jpg');
const heroAlt = start.heroBild ? 'Foto aus dem Kindergartenalltag' : 'Kinder backen Stockbrot am Feuer im Kindergartengarten';

const gruppenFotos = [
  { datei: 'sand.jpg', alt: 'Zwei Kinder spielen im Sandkasten' },
  { datei: 'bauen.jpg', alt: 'Drei Kinder bauen einen hohen Turm aus Holzplättchen' },
];

const farben = [
  { titel: 'Rhythmus', bg: 'var(--roetel)', fg: '#fff', text: 'Wiederkehrende Tages-, Wochen- und Jahresläufe geben Halt und Orientierung.' },
  { titel: 'Freies Spiel', bg: 'var(--honig)', fg: 'var(--text)', text: 'Tücher, Holz, Wolle – wenig Spielzeug, viel Raum für Fantasie, drinnen wie draußen.' },
  { titel: 'Natur', bg: 'var(--blatt)', fg: '#fff', text: 'Unser Südgarten grenzt an eine große Wiese und das Naturschutzgebiet Kiesgrube.' },
  { titel: 'Gemeinschaft', bg: 'var(--flieder)', fg: 'var(--text)', text: 'Eltern, Kinder und Team gestalten den Kindergarten gemeinsam.' },
];

/** Erster Satz der Gruppenbeschreibung als Kurztext für die Karte */
// Punkte nach Zahlen („vom 3. Lebensjahr“) zählen nicht als Satzende.
const ersterSatz = (text: string) => text.match(/^.*?\D[.!?](?=\s|$)/)?.[0] ?? text;

const gesuchtLinks = [
  { titel: 'Mitarbeit im Team', text: 'Bewerbung gern per Mail', href: '/stellen#bewerben' },
  ...stellen.map((s) => ({ titel: s.entry.titel, text: [s.entry.umfang, s.entry.start].filter(Boolean).join(' · '), href: `/stellen#${s.slug}` })),
  { titel: 'Praktikum & Ausbildung', text: 'Mit Praxisanleitung', href: '/stellen#praktikum' },
];
---
<Base title="Startseite" description={start.heroText}>
  <div slot="kopf" class="wrap hero">
    <div class="hero-text">
      <h1 class="h1 hero-titel">
        {hervorheben(start.heroTitel).map(({ teil, hervor }) => (hervor ? <span class="gelb">{teil}</span> : teil))}
      </h1>
      <p class="hero-lead">{start.heroText}</p>
      <div class="hero-knoepfe">
        <a href="/kontakt" class="hk hk-weiss">Besuch vereinbaren</a>
        <a href="/fuer-eltern#anmeldung" class="hk hk-rahmen">So klappt die Anmeldung</a>
      </div>
    </div>
    <div class="hero-bild">
      <Image src={heroBild} alt={heroAlt} widths={[400, 800]} sizes="(min-width: 900px) 400px, 76vw" loading="eager" fetchpriority="high" />
      <span style="top:0;left:38%;width:22%;background:var(--roetel)"></span>
      <span style="top:30%;right:0;width:20%;background:var(--kuerbis)"></span>
      <span style="bottom:2%;right:16%;width:16%;background:var(--flieder)"></span>
      <span style="bottom:6%;left:4%;width:20%;background:var(--blatt)"></span>
      <span style="top:18%;left:0;width:14%;background:var(--honig)"></span>
    </div>
  </div>

  <section class="wrap section" style="padding-top:110px" aria-labelledby="farben-titel">
    <h2 class="h2" id="farben-titel">Vier Farben, aus denen unser Tag gemacht ist.</h2>
    <div class="grid" style="--min:250px;gap:28px">
      {farben.map((f) => (
        <div class="stack" style="gap:16px">
          <h3 class="wachs" style={`background:${f.bg};color:${f.fg}`}>{f.titel}</h3>
          <p class="p">{f.text}</p>
        </div>
      ))}
    </div>
    <a href="/ueber-uns#paedagogik" class="btn">Mehr über unsere Pädagogik</a>
  </section>

  <section class="bg-honig" aria-labelledby="gruppen-titel">
    <div class="wrap section" style="padding-top:100px;padding-bottom:100px">
      <h2 class="h2" id="gruppen-titel">Es waren einmal zwei Gruppen …</h2>
      <div class="grid" style="--min:440px;gap:28px">
        {gruppen.gruppen.map((g, i) => {
          const foto = gruppenFotos[i % gruppenFotos.length];
          const anker = g.name.toLowerCase().replace(/ß/g, 'ss').replace(/[^a-z]/g, '');
          return (
            <a href={`/gruppen#${anker}`} class:list={['maerchen', i % 2 ? 'maerchen-hell' : 'maerchen-rot']}>
              <Image src={bild(g.bild, foto.datei)} alt={g.bild ? `Foto der Gruppe ${g.name}` : foto.alt} widths={[440, 880]} sizes="(min-width: 1000px) 600px, 92vw" />
              <span class="maerchen-text">
                <span class="maerchen-name">{g.name}</span>
                <span class="maerchen-kurz">{ersterSatz(g.text)}</span>
                <span class="maerchen-mehr" aria-hidden="true">Gruppe ansehen →</span>
              </span>
            </a>
          );
        })}
      </div>
      <div class="pills">
        <a href="/gruppen#ganztag" class="pill-link">Ganztag im Zwergenstübchen →</a>
        <a href="/gruppen#vorschule" class="pill-link">Vorschulprogramm →</a>
        <a href="/fuer-eltern#zeiten" class="pill-link">Öffnungszeiten &amp; Beiträge →</a>
        <a href="/fuer-eltern#anmeldung" class="pill-link pill-dunkel">Anmeldung →</a>
      </div>
    </div>
  </section>

  <section class="wrap section" id="jahreskreis" style="padding-top:110px;padding-bottom:110px">
    <Jahreskreis>
      <Image src={bild('moos.jpg')} alt="Kleine Filzwichtel und ein Windlicht auf Moos im Garten" class="foto" style="--h:240px" widths={[600, 1200]} sizes="(min-width: 1000px) 600px, 92vw" />
      <a href="/fuer-eltern#downloads" class="linkpfeil">Zum Jahresplan mit allen Terminen →</a>
    </Jahreskreis>
  </section>

  <section class="bg-sand" aria-labelledby="pinnwand-titel">
    <div class="wrap section" style="padding-top:100px;padding-bottom:100px">
      <div class="kopfzeile">
        <h2 class="h2" id="pinnwand-titel">Neu an der Pinnwand</h2>
        <a href="/aktuelles" class="linkpfeil">Alle Berichte →</a>
      </div>
      <div class="pinnwand" style="gap:36px">
        {posts.map((p, i) => (
          <Zettel slug={p.slug} titel={p.entry.titel} datum={p.entry.datum} jahreszeit={p.entry.jahreszeit} teaser={p.entry.teaser} index={i} />
        ))}
      </div>
    </div>
  </section>

  <section class="wrap section split" style="padding-top:110px;padding-bottom:110px" aria-labelledby="gesucht-titel">
    <p class="gesucht" id="gesucht-titel"><strong>Gesucht!</strong><span>Menschen mit Herz für Kinder</span></p>
    <ul class="gesucht-liste">
      {gesuchtLinks.map((l) => (
        <li>
          <a href={l.href}>
            <span><strong>{l.titel}</strong>{l.text && <span>{l.text}</span>}</span>
            <span aria-hidden="true" class="pfeil">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .hero {
    padding-top: 56px;
    padding-bottom: 96px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 48px;
    align-items: center;
  }
  .hero-text { display: flex; flex-direction: column; gap: 26px; }
  .hero-titel { font-weight: 800; font-size: clamp(48px, 7.5vw, 112px); line-height: 0.93; letter-spacing: -0.045em; }
  .gelb { color: var(--honig); }
  .hero-lead { margin: 0; font-size: 20px; line-height: 1.55; max-width: 540px; color: #e6edd8; }
  .hero-knoepfe { display: flex; flex-wrap: wrap; gap: 12px; }
  .hk { text-decoration: none; font-weight: 700; font-size: 18px; padding: 17px 28px; border-radius: 999px; }
  .hk-weiss { background: #fff; color: var(--moos); }
  .hk-weiss:hover { color: var(--roetel) !important; }
  .hk-rahmen { color: #fff; border: 2px solid #fff; }
  .hk-rahmen:hover { background: rgba(255, 255, 255, 0.12); }
  .hero-bild { position: relative; width: min(100%, 520px); aspect-ratio: 1; justify-self: center; }
  .hero-bild img { position: absolute; inset: 12%; width: 76%; height: 76%; object-fit: cover; border-radius: 50%; }
  .hero-bild span { position: absolute; aspect-ratio: 1; border-radius: 50%; }

  /* Wachsmalblöcke */
  .wachs {
    margin: 0;
    height: 120px;
    clip-path: polygon(7% 0, 93% 0, 100% 100%, 0 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-titel);
    font-weight: 800;
    font-size: 30px;
    letter-spacing: -0.02em;
  }

  /* Märchen-Gruppenkarten */
  .maerchen {
    text-decoration: none;
    border-radius: 32px;
    padding: 18px 18px 34px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    transition: transform 0.2s;
  }
  .maerchen-rot { color: #fff; background: var(--roetel); transform: rotate(-1deg); }
  .maerchen-hell { color: var(--moos); background: #fffdf6; border: 2px solid var(--rahmen); transform: rotate(1deg); }
  .maerchen:hover, .maerchen:focus-visible { transform: rotate(0deg); }
  .maerchen-rot:hover { color: #fff; }
  .maerchen-hell:hover { color: var(--moos); }
  .maerchen img { width: 100%; height: 260px; object-fit: cover; border-radius: 22px; }
  .maerchen-text { display: flex; flex-direction: column; gap: 10px; padding: 0 18px; }
  .maerchen-name { font-family: var(--font-titel); font-weight: 800; font-size: clamp(28px, 8.5vw, 48px); letter-spacing: -0.03em; line-height: 1; overflow-wrap: break-word; hyphens: auto; }
  .maerchen-kurz { font-size: 18px; line-height: 1.5; }
  .maerchen-mehr { font-weight: 700; font-size: 17px; }

  .pill-link { text-decoration: none; color: var(--text); background: #fffdf6; font-weight: 700; padding: 14px 22px; border-radius: 999px; }
  .pill-dunkel { color: #fff; background: var(--moos); }
  .pill-dunkel:hover { color: #fff; background: #2f5234; }

  .kopfzeile { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; }

  .gesucht { margin: 0; padding: 44px 52px; }
  .gesucht-liste { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 14px; }
  .gesucht-liste a {
    text-decoration: none;
    color: var(--text);
    border: 2px solid var(--rahmen);
    border-radius: 22px;
    padding: 22px 26px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .gesucht-liste a:hover { color: var(--roetel); border-color: var(--roetel); }
  .gesucht-liste a > span:first-child { display: flex; flex-direction: column; gap: 4px; }
  .gesucht-liste strong { font-size: 20px; }
  .gesucht-liste a > span:first-child > span { font-size: 16px; }
  .pfeil { font-size: 24px; }
</style>
