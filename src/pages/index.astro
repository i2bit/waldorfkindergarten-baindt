---
// Startseite nach dem Vorbild waldorfkindergarten-wurzelwerk.de: farbiges Band mit
// Logo, Spruch und Knopf, dann schmale Textspalte (Willkommen, Hinweis auf Plätze,
// offene Stellen, Neues) und ein breites Foto. Alles in Keystatic pflegbar.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { reader, getAktuelles, bild, renderMarkdoc, nurText, datumLang } from '../lib/content';
import logo from '../assets/logo.png';

const start = await reader.singletons.startseite.readOrThrow();
const posts = (await getAktuelles()).slice(0, 3);
const stellen = (await reader.collections.stellen.all()).filter((s) => s.entry.aktiv);

const willkommen = renderMarkdoc(start.willkommen.node);
const beschreibung = nurText(start.willkommen.node).slice(0, 160);
const zitatZeilen = start.zitat.split('\n').map((z) => z.trim()).filter(Boolean);
---
<Base title="Startseite" description={beschreibung}>
  <div slot="kopf" class="wrap hero">
    <h1 class="visually-hidden">Waldorfkindergarten Baindt</h1>
    <Image src={logo} alt="" class="hero-logo" width={86} height={150} densities={[1, 2]} loading="eager" />
    {zitatZeilen.length > 0 && (
      <figure class="zitat">
        <blockquote>
          <p>„{zitatZeilen.map((z, i) => <>{i > 0 && <br />}{z}</>)}“</p>
        </blockquote>
        {start.zitatQuelle && <figcaption>{start.zitatQuelle}</figcaption>}
      </figure>
    )}
    <a href="/anmeldung" class="knopf-rahmen">Aufnahmeantrag</a>
  </div>

  <section class="spalte" aria-labelledby={start.willkommenTitel ? 'willkommen' : undefined} aria-label={start.willkommenTitel ? undefined : 'Willkommen'}>
    {start.willkommenTitel && <h2 class="h2 mitte" id="willkommen">{start.willkommenTitel}</h2>}
    <div class="prosa" set:html={willkommen} />
    <a href="/ueber-uns" class="linkpfeil">Geschichte, Pädagogik und Team →</a>
  </section>

  <section class="kasten" aria-labelledby="platz-titel">
    <div class="spalte">
      <h2 class="kasten-titel" id="platz-titel">{start.platzTitel}</h2>
      <p class="p">{start.platzText}</p>
      <div class="knoepfe">
        <a href="/anmeldung" class="knopf-rahmen">Aufnahmeantrag</a>
        <a href="/kontakt" class="linkpfeil">Besuch vereinbaren →</a>
      </div>
    </div>
  </section>

  {stellen.length > 0 && (
    <section class="spalte" aria-labelledby="stellen-titel">
      <h2 class="klein-titel" id="stellen-titel">Stellen/Mitarbeit</h2>
      <ul class="neues">
        {stellen.map((s) => <li><a href={`/stellen#${s.slug}`}>{s.entry.titel}</a></li>)}
      </ul>
      <a href="/stellen" class="linkpfeil">Alle Stellen →</a>
    </section>
  )}

  {posts.length > 0 && (
    <section class="spalte" aria-labelledby="aktuelles-titel">
      <h2 class="klein-titel" id="aktuelles-titel">Aktuelles</h2>
      <ul class="neues">
        {posts.map((p) => (
          <li><a href={`/aktuelles/${p.slug}`}>{p.entry.titel}</a> <span class="p-leise">{datumLang(p.entry.datum)}</span></li>
        ))}
      </ul>
      <a href="/aktuelles" class="linkpfeil">Alle Berichte →</a>
    </section>
  )}

  {start.heroBild && (
    <div class="breitbild welle-oben">
      <Image src={bild(start.heroBild)} alt={start.heroBildAlt ?? ''} widths={[800, 1440, 2000]} sizes="100vw" />
    </div>
  )}
</Base>

<style>
  .hero { padding-top: 56px; padding-bottom: 64px; display: flex; flex-direction: column; align-items: center; gap: 28px; text-align: center; }
  .hero-logo { height: 140px; width: auto; }
  .zitat { margin: 0; max-width: 1080px; }
  .zitat blockquote { margin: 0; }
  .zitat p {
    margin: 0;
    font-family: var(--font-titel);
    font-size: clamp(22px, 2.6vw, 36px);
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    text-wrap: balance;
  }
  .zitat figcaption { margin-top: 14px; font-size: 17px; }

  .knopf-rahmen {
    display: inline-block;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
    font-size: 15px;
    color: var(--text);
    border: 1.5px solid var(--text);
    border-radius: 6px;
    padding: 16px 30px;
  }
  .knopf-rahmen:hover { background: var(--text); color: #fff; }

  /* Schmale Textspalte wie bei Wurzelwerk */
  .spalte { max-width: 640px; margin: 0 auto; padding: 56px 24px; display: flex; flex-direction: column; gap: 18px; }
  .mitte { text-align: center; font-size: clamp(30px, 4vw, 42px); }
  .klein-titel { margin: 0; font-family: var(--font-titel); font-weight: normal; font-size: 26px; text-transform: uppercase; letter-spacing: 0.04em; }
  .linkpfeil { color: var(--text); }
  .linkpfeil:hover { color: var(--akzent); }

  .kasten { background: var(--hell-rosa); }
  .kasten-titel { margin: 0; font-family: var(--font-text); font-weight: 700; font-size: 22px; }
  .knoepfe { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; }

  .neues { margin: 0; padding: 0; list-style: none; }
  .neues li { padding: 10px 0; border-bottom: 1px solid var(--linie); font-size: 18px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; }
  .neues a { font-weight: 600; }
  .neues .p-leise { font-size: 15px; }

  .breitbild { margin-top: 24px; }
  .breitbild img { width: 100%; height: clamp(260px, 38vw, 560px); object-fit: cover; }
  .breitbild.welle-oben::before { z-index: 1; }
</style>
