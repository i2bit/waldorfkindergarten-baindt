---
import { isExternal } from '../lib/content';

interface Props {
  href: string;
  titel: string;
  beschreibung?: string | null;
}
const { href, titel, beschreibung } = Astro.props;
const extern = isExternal(href);
const pdf = /\.pdf($|\?)/i.test(href);
---
<a class="dl" href={href} target={extern || pdf ? '_blank' : undefined} rel={extern ? 'noopener' : undefined}>
  <span>
    <strong>{titel}</strong>
    {beschreibung && <small>{beschreibung}</small>}
  </span>
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"></path></svg>
  {(extern || pdf) && <span class="visually-hidden">(öffnet in neuem Tab)</span>}
</a>
