---
// Seitenkopf der Unterseiten im farbigen Band: große Überschrift, Einleitung.
interface Props {
  titel: string;
  farbe: string;
  lead?: string;
}
const { titel, farbe, lead } = Astro.props;
---
<div class="wrap seitenkopf">
  <h1 class="h1">{titel}</h1>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</div>
