---
// Gemeinsames Layout: Kopf mit Logo, Anruf-Knopf und Pill-Navigation,
// darunter der Seitenkopf (Slot "kopf"), Inhalt und roter Fußbereich.
import '../styles/global.css';
import { Image } from 'astro:assets';
import { getKontakt, reader } from '../lib/content';
import Hinweisbalken from '../components/Hinweisbalken.astro';
import logo from '../assets/logo.png';

interface Props {
  title: string;
  description?: string;
  /** Pfad des aktiven Menüpunkts, z. B. "/gruppen" */
  aktiv?: string;
}

const { title, description, aktiv } = Astro.props;
const kontakt = await getKontakt();
const verein = await reader.singletons.verein.readOrThrow();

const navigation = [
  { href: '/ueber-uns', label: 'Über uns' },
  { href: '/gruppen', label: 'Gruppen' },
  { href: '/fuer-eltern', label: 'Für Eltern' },
  { href: '/aktuelles', label: 'Aktuelles' },
  { href: '/stellen', label: 'Stellen' },
  { href: '/anmeldung', label: 'Anmeldung' },
  { href: '/kontakt', label: 'Kontakt' },
];

const seitentitel = title === 'Startseite' ? 'Waldorfkindergarten Baindt' : `${title} · Waldorfkindergarten Baindt`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitentitel}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#FFFCF9" />
    {import.meta.env.BASE_URL !== '/' && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <header class="kopf">
      <div class="wrap kopf-leiste">
        <a class="logo" href="/" aria-label="Waldorfkindergarten Baindt – zur Startseite">
          <Image src={logo} alt="" width={32} height={56} densities={[1, 2]} loading="eager" />
          <span>Waldorfkindergarten Baindt</span>
        </a>
        <nav class="nav-text" aria-label="Hauptnavigation">
          {navigation.map((item) => (
            <a href={item.href} aria-current={aktiv === item.href ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <!-- Menü fürs Handy: <details> klappt ohne JavaScript auf und zu -->
        <details class="menue">
          <summary>
            <span>Menü</span>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path class="striche" d="M3 6h18M3 12h18M3 18h18"></path><path class="kreuz" d="M5 5l14 14M19 5L5 19"></path></svg>
          </summary>
          <nav class="menue-panel" aria-label="Hauptnavigation">
            <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Startseite</a>
            {navigation.map((item) => (
              <a href={item.href} aria-current={aktiv === item.href ? 'page' : undefined}>{item.label}</a>
            ))}
            <a href={kontakt.telHref} class="menue-anrufen">Anrufen: {kontakt.telefon}</a>
          </nav>
        </details>
      </div>
      <div class="band welle-unten">
        <slot name="kopf" />
      </div>
    </header>

    <main id="inhalt" tabindex="-1">
      <slot />
    </main>

    <footer class="fuss">
      <div class="wrap fuss-innen">
        <div class="fuss-kontakt">
          <strong>Waldorfkindergarten Baindt</strong>
          <span>{kontakt.strasse} · {kontakt.ort}</span>
          <span><a href={kontakt.telHref}>{kontakt.telefon}</a> · <a href={kontakt.mailHref}>{kontakt.email}</a></span>
        </div>
        <div class="fuss-unten">
          <span>© {new Date().getFullYear()} {verein.name}</span>
          <nav aria-label="Rechtliches">
            <a href="/kontakt">Kontakt</a>
            <a href="/impressum">Impressum</a>
            <a href="/datenschutz">Datenschutz</a>
          </nav>
        </div>
      </div>
    </footer>
    <Hinweisbalken />
  </body>
</html>
