---
// Gemeinsames Layout: Kopf mit Logo, Anruf-Knopf und Pill-Navigation,
// darunter der Seitenkopf (Slot "kopf"), Inhalt und roter Fußbereich.
import '../styles/global.css';
import { getKontakt, reader } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  /** Pfad des aktiven Menüpunkts, z. B. "/gruppen" */
  aktiv?: string;
}

const { title, description, aktiv } = Astro.props;
const kontakt = await getKontakt();
const verein = await reader.singletons.verein.readOrThrow();

const navigation = [
  { href: '/ueber-uns', label: 'Über uns', farbe: 'var(--ocker)' },
  { href: '/gruppen', label: 'Gruppen', farbe: 'var(--krapp)' },
  { href: '/fuer-eltern', label: 'Für Eltern', farbe: 'var(--flieder)' },
  { href: '/aktuelles', label: 'Aktuelles', farbe: 'var(--orange)' },
  { href: '/stellen', label: 'Stellen', farbe: 'var(--waid)' },
  { href: '/kontakt', label: 'Kontakt', farbe: '#FFFFFF' },
];

const seitentitel = title === 'Startseite' ? 'Waldorfkindergarten Baindt' : `${title} · Waldorfkindergarten Baindt`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitentitel}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#26337A" />
    {import.meta.env.BASE_URL !== '/' && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <header class="kopf">
      <div class="wrap kopf-leiste">
        <a class="logo" href="/" aria-label="Waldorfkindergarten Baindt – zur Startseite">
          <svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true"><circle cx="17" cy="17" r="8" fill="#F3C33C"></circle><circle cx="17" cy="5" r="5" fill="#C7384A"></circle><circle cx="28" cy="17" r="5" fill="#E8793A"></circle><circle cx="17" cy="29" r="5" fill="#2F7A55"></circle><circle cx="6" cy="17" r="5" fill="#B8A6E0"></circle></svg>
          <span>Waldorfkindergarten<br />Baindt</span>
        </a>
        <a class="anrufen" href={kontakt.telHref} aria-label={`Anrufen: ${kontakt.telefon}`}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>
          <span class="anrufen-text">Anrufen</span>
        </a>
      </div>
      <nav class="wrap nav-pills" aria-label="Hauptnavigation">
        {navigation.map((item) => (
          <a href={item.href} aria-current={aktiv === item.href ? 'page' : undefined}>
            <span class="dot" style={`background:${item.farbe}`} aria-hidden="true"></span>
            {item.label}
          </a>
        ))}
      </nav>
      <slot name="kopf" />
    </header>

    <main id="inhalt" tabindex="-1">
      <slot />
    </main>

    <footer class="fuss">
      <div class="wrap fuss-innen">
        <div class="fuss-oben">
          <h2 class="h2">Besuchen Sie uns!</h2>
          <div class="fuss-wege">
            <a href={kontakt.telHref} style="background:#fff">Anrufen: {kontakt.telefon}</a>
            <a href={kontakt.mailHref} style="background:var(--ocker)">{kontakt.email}</a>
            <span>{kontakt.strasse}, {kontakt.ort}</span>
          </div>
        </div>
        <div class="fuss-unten">
          <span>© Waldorfkindergarten Baindt · {verein.name}</span>
          <nav aria-label="Rechtliches">
            <a href="/kontakt">Kontakt</a>
            <a href="/impressum">Impressum</a>
            <a href="/datenschutz">Datenschutz</a>
          </nav>
        </div>
      </div>
    </footer>
  </body>
</html>
